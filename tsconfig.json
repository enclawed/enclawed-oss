{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023", "ScriptHost"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noEmitOnError": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2023",
    "types": ["node"],
    "useDefineForClassFields": false,
    "paths": {
      "@enclawed/extension-api": ["./src/extensionAPI.ts"],
      "@enclawed/plugin-sdk": ["./src/plugin-sdk/index.ts"],
      "@enclawed/plugin-sdk/*": ["./src/plugin-sdk/*.ts"],
      "@enclawed/plugin-sdk": ["./src/plugin-sdk/index.ts"],
      "@enclawed/plugin-sdk/*": ["./src/plugin-sdk/*.ts"],
      "@enclawed/plugin-sdk/account-id": ["./src/plugin-sdk/account-id.ts"],
      "@enclawed/module-trust/*.js": ["./enclawed/ts/*.ts"],
    "@enclawed/mcp-attested": ["./extensions/mcp-attested/src/index.ts"],
    "@enclawed/mcp-google-workspace": ["./extensions/mcp-google-workspace/src/index.ts"],
    "@enclawed/mcp-imap-smtp": ["./extensions/mcp-imap-smtp/src/index.ts"],
    "@enclawed/mcp-caldav": ["./extensions/mcp-caldav/src/index.ts"],
    "@enclawed/mcp-carddav": ["./extensions/mcp-carddav/src/index.ts"],
    "@enclawed/*": ["./extensions/*"]
    }
  },
  "include": ["src/**/*", "ui/**/*", "extensions/**/*", "packages/**/*"],
  "exclude": ["node_modules", "dist", "**/dist/**", "attic/**", "extensions/qa-matrix/**"]
}
